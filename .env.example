SK_APP_ENV=production
SK_APP_URL=https://example.cz
SK_DB_HOST=127.0.0.1
SK_DB_PORT=3306
# Pouzij existujici sdilenou databazi Metrobusu.
SK_DB_NAME=metrobus_shared_database
SK_DB_USER=metrobus_shared_user
SK_DB_PASS=change-me
# Vsechny tabulky Sotousova kalendare musi zustat oddelene prefixem.
SK_DB_TABLE_PREFIX=sk_
SK_SESSION_NAME=sk_admin
SK_SESSION_SECURE=1
SK_SHEET_SYNC_TOKEN=generate-a-long-random-secret
